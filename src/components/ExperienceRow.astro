---
interface Props {
  company: string;
  position: string;
  tenure: string;
  description: string;
}

const { company, position, tenure, description } = Astro.props;
---

<div class="border-t border-neutral-200 dark:border-neutral-900 py-6 grid grid-cols-1 sm:grid-cols-[9rem_1fr] gap-2 sm:gap-8">
  <span class="font-mono text-xs text-neutral-400 dark:text-neutral-600 sm:pt-1">{tenure}</span>
  <div>
    <h3 class="text-[15px] font-medium text-black dark:text-white">{company}</h3>
    <p class="mt-1 text-xs text-neutral-400 dark:text-neutral-500">{position}</p>
    <p class="mt-3 text-sm text-neutral-500 leading-relaxed">{description}</p>
  </div>
</div>
