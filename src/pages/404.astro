---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <main class="max-w-2xl mx-auto px-6 pt-14">
    <p class="anim-rise font-mono text-xs text-neutral-400 dark:text-neutral-600">404</p>
    <h1 class="anim-rise anim-delay-1 mt-3 text-2xl sm:text-3xl text-black dark:text-white font-semibold tracking-tight">
      Page not found
    </h1>
    <p class="anim-rise anim-delay-2 mt-6 text-[15px] leading-relaxed">
      That page doesn&apos;t exist. Try the <a href="/" class="link-underline text-black dark:text-white">home page</a>
      or the <a href="/blog" class="link-underline text-black dark:text-white">blog</a>.
    </p>
  </main>
</BaseLayout>
